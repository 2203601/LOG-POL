# Copiar como .env y completar los valores

# MongoDB Atlas — obtener en cloud.mongodb.com → Connect → Drivers
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Clave secreta para firmar JWT — generá una con: openssl rand -hex 64
JWT_SECRET=cambiar-por-clave-segura

# URL del frontend en producción (para CORS)
# En local no hace falta cambiar, usa http://localhost:5173 por defecto
CORS_ORIGIN=https://logpol-app.onrender.com

# Puerto del servidor (Render usa 10000 por defecto)
PORT=3001
